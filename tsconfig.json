{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedParameters": false,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom",
      "ES2019"
    ],
    "paths": {
      "@shared/*": [
        "src/app/eatecui/source/shared/*"
      ],
      "@transaction/*": [
        "src/app/eatecui/source/transaction/*"
      ],
      "@coreModels/*": [
        "src/app/eatecui/source/core/*"
      ],
      "@ngrxStore/*": [
        "src/app/eatecui/source/store/*"
      ],
      "@scss/*": [
        "src/app/eatecui/src/assets/sass/*"
      ],
      "@assets/*": [
        "src/app/eatecui/src/assets/*"
      ],
      "grid": [
        "src/app/eatecui/dist/grid"
      ],
      "grid/*": [
        "src/app/eatecui/dist/grid/*"
      ],
      "AgilysysDynamicGrid": [
        "src/app/eatecui/dist/AgilysysDynamicGrid"
      ],
      "AgilysysDynamicGrid/*": [
        "src/app/eatecui/dist/AgilysysDynamicGrid/*"
      ],
      "agilysys-button": [
        "src/app/eatecui/dist/agilysys-button"
      ],
      "agilysys-button/*": [
        "src/app/eatecui/dist/agilysys-button/*"
      ],
      "agilysys-dynamicform": [
        "src/app/eatecui/dist/agilysys-dynamicform"
      ],
      "agilysys-dynamicform/*": [
        "src/app/eatecui/dist/agilysys-dynamicform/*"
      ]
    },
    "useDefineForClassFields": false,
    "skipLibCheck": true
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": false,
    "strictTemplates": false
  }
}
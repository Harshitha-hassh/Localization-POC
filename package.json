{
  "name": "retail-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node prepare-build.js",
    "build": "node --max-old-space-size=20480 node_modules/@angular/cli/bin/ng build --configuration=development --source-map --base-href /Retail/",
    "serve": "node --max-old-space-size=20480 node_modules/@angular/cli/bin/ng serve --port 3000 --configuration=development",
    "appliance-build": "node --max-old-space-size=8192 node_modules/@angular/cli/bin/ng build --base-href /Retail/",
    "dev-build": "ng build --configuration=development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "clean": "rmdir /s /q node_modules",
    "getlatestcode": "git pull -f && git submodule foreach git pull -f",
    "stageretailsubmodule": "git pull -f && git submodule foreach git pull -f && git stage src/app/retail"
  },
  "overrides": {
    "colorette": "2.0.13"
  },
  "private": true,
